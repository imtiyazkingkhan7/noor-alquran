  "surahs": {
    "1": {
      "number": 1,
      "name": "سُورَةُ ٱلْفَاتِحَةِ",
      "englishName": "Al-Faatiha",
      "englishNameTranslation": "The Opening",
      "revelationType": "Meccan",
      "ayahs": [
        {"globalNumber": 1, "numberInSurah": 1, "page": 1, "juz": 1, "ruku": 1, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ", "translation": "In the name of Allah, the Entirely Merciful, the Especially Merciful."},
        {"globalNumber": 2, "numberInSurah": 2, "page": 1, "juz": 1, "ruku": 1, "text": "ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ", "translation": "[All] praise is [due] to Allah, Lord of the worlds."},
        {"globalNumber": 3, "numberInSurah": 3, "page": 1, "juz": 1, "ruku": 1, "text": "ٱلرَّحْمَٰنِ ٱلرَّحِيمِ", "translation": "The Entirely Merciful, the Especially Merciful."},
        {"globalNumber": 4, "numberInSurah": 4, "page": 1, "juz": 1, "ruku": 1, "text": "مَٰلِكِ يَوْمِ ٱلدِّينِ", "translation": "Sovereign of the Day of Recompense."},
        {"globalNumber": 5, "numberInSurah": 5, "page": 1, "juz": 1, "ruku": 1, "text": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ", "translation": "It is You we worship and You we ask for help."},
        {"globalNumber": 6, "numberInSurah": 6, "page": 1, "juz": 1, "ruku": 1, "text": "ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ", "translation": "Guide us to the straight path."},
        {"globalNumber": 7, "numberInSurah": 7, "page": 1, "juz": 1, "ruku": 1, "text": "صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ", "translation": "The path of those upon whom You have bestowed favor, not of those who have evoked [Your] anger or of those who are astray."}
      ]
    },
    "103": {
      "number": 103,
      "name": "سُورَةُ العَصْرِ",
      "englishName": "Al-Asr",
      "englishNameTranslation": "The Declining Day",
      "revelationType": "Meccan",
      "ayahs": [
        {"globalNumber": 6177, "numberInSurah": 1, "page": 601, "juz": 30, "ruku": 1, "text": "وَٱلْعَصْرِ", "translation": "By time."},
        {"globalNumber": 6178, "numberInSurah": 2, "page": 601, "juz": 30, "ruku": 1, "text": "إِنَّ ٱلْإِنسَٰنَ لَفِى خُسْرٍ", "translation": "Indeed, mankind is in loss."},
        {"globalNumber": 6179, "numberInSurah": 3, "page": 601, "juz": 30, "ruku": 1, "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ", "translation": "Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience."}
      ]
    },
    "108": {
      "number": 108,
      "name": "سُورَةُ الكَوْثَرِ",
      "englishName": "Al-Kawthar",
      "englishNameTranslation": "The Abundance",
      "revelationType": "Meccan",
      "ayahs": [
        {"globalNumber": 6205, "numberInSurah": 1, "page": 602, "juz": 30, "ruku": 1, "text": "إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ", "translation": "Indeed, We have granted you, [O Muhammad], al-Kawthar."},
        {"globalNumber": 6206, "numberInSurah": 2, "page": 602, "juz": 30, "ruku": 1, "text": "فَصَلِّ لِرَبِّكَ وَٱنْحَرْ", "translation": "So pray to your Lord and sacrifice [to Him alone]."},
        {"globalNumber": 6207, "numberInSurah": 3, "page": 602, "juz": 30, "ruku": 1, "text": "إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ", "translation": "Indeed, your enemy is the one cut off."}
      ]
    },
    "112": {
      "number": 112,
      "name": "سُورَةُ الإِخْلَاصِ",
      "englishName": "Al-Ikhlaas",
      "englishNameTranslation": "Sincerity",
      "revelationType": "Meccan",
      "ayahs": [
        {"globalNumber": 6222, "numberInSurah": 1, "page": 604, "juz": 30, "ruku": 1, "text": "قُلْ هُوَ ٱللَّهُ أَحَدٌ", "translation": "Say, He is Allah, [who is] One."},
        {"globalNumber": 6223, "numberInSurah": 2, "page": 604, "juz": 30, "ruku": 1, "text": "ٱللَّهُ ٱلصَّمَدُ", "translation": "Allah, the Eternal Refuge."},
        {"globalNumber": 6224, "numberInSurah": 3, "page": 604, "juz": 30, "ruku": 1, "text": "لَمْ يَلِدْ وَلَمْ يُولَدْ", "translation": "He neither begets nor is born."},
        {"globalNumber": 6225, "numberInSurah": 4, "page": 604, "juz": 30, "ruku": 1, "text": "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ", "translation": "Nor is there to Him any equivalent."}
      ]
    },
    "113": {
      "number": 113,
      "name": "سُورَةُ الفَلَقِ",
      "englishName": "Al-Falaq",
      "englishNameTranslation": "The Daybreak",
      "revelationType": "Meccan",
      "ayahs": [
        {"globalNumber": 6226, "numberInSurah": 1, "page": 604, "juz": 30, "ruku": 1, "text": "قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ", "translation": "Say, I seek refuge in the Lord of daybreak."},
        {"globalNumber": 6227, "numberInSurah": 2, "page": 604, "juz": 30, "ruku": 1, "text": "مِن شَرِّ مَا خَلَقَ", "translation": "From the evil of that which He created."},
        {"globalNumber": 6228, "numberInSurah": 3, "page": 604, "juz": 30, "ruku": 1, "text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ", "translation": "And from the evil of darkness when it settles."},
        {"globalNumber": 6229, "numberInSurah": 4, "page": 604, "juz": 30, "ruku": 1, "text": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ", "translation": "And from the evil of the blowers in knots."},
        {"globalNumber": 6230, "numberInSurah": 5, "page": 604, "juz": 30, "ruku": 1, "text": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ", "translation": "And from the evil of an envier when he envies."}
      ]
    },
    "114": {
      "number": 114,
      "name": "سُورَةُ النَّاسِ",
      "englishName": "An-Naas",
      "englishNameTranslation": "Mankind",
      "revelationType": "Meccan",
      "ayahs": [
        {"globalNumber": 6231, "numberInSurah": 1, "page": 604, "juz": 30, "ruku": 1, "text": "قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ", "translation": "Say, I seek refuge in the Lord of mankind."},
        {"globalNumber": 6232, "numberInSurah": 2, "page": 604, "juz": 30, "ruku": 1, "text": "مَلِكِ ٱلنَّاسِ", "translation": "The Sovereign of mankind."},
        {"globalNumber": 6233, "numberInSurah": 3, "page": 604, "juz": 30, "ruku": 1, "text": "إِلَٰهِ ٱلنَّاسِ", "translation": "The God of mankind."},
        {"globalNumber": 6234, "numberInSurah": 4, "page": 604, "juz": 30, "ruku": 1, "text": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ", "translation": "From the evil of the retreating whisperer."},
        {"globalNumber": 6235, "numberInSurah": 5, "page": 604, "juz": 30, "ruku": 1, "text": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ", "translation": "Who whispers [evil] into the breasts of mankind."},
        {"globalNumber": 6236, "numberInSurah": 6, "page": 604, "juz": 30, "ruku": 1, "text": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ", "translation": "From among the jinn and mankind."}
      ]
    }
  }
}
